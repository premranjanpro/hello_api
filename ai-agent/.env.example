# LiveKit Credentials (Matches local livekit-server/config.yaml or LiveKit Cloud)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretkeyshouldbe48characterslongforsecurity!

# Groq API Key (Obtain free from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Primary .NET API Backend (hello_api)
HELLO_API_URL=http://localhost:5063
